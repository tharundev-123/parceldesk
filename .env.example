# ParcelDesk Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration (DP-900 / Azure SQL Database)
# Set to 'azure_sql' when deploying with Azure SQL; defaults to 'sqlite' for local development
DB_TYPE=sqlite
SQLITE_DB_PATH=database/parceldesk.db

# Azure SQL Database Connection String (uncomment & populate for production)
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server-name>.database.windows.net,1433;Database=parceldesk-db;Uid=<username>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Azure Blob Storage Configuration (uncomment & populate for cloud photo storage)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage-account>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=parcel-photos

# Security Settings
OTP_EXPIRY_MINUTES=15
MAX_OTP_ATTEMPTS=3
